{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff ",
        "IncludeScopes": false
      }
    }
  },
  "AllowedHosts": "*",
  "Cache": {
    "Backend": "FileSystem",
    "Directory": "cache",
    "MaxBytes": 5368709120,
    "MaxIdle": "30.00:00:00",
    "CleanupInterval": "00:10:00",
    "DownloadOnMiss": false,
    "MaxConcurrentDownloads": 2,
    "QueueCapacity": 1000,
    "PublicBaseUrl": null
  }
}
